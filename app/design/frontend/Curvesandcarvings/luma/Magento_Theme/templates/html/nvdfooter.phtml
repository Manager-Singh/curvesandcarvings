.cc-instagram-feed a[href*="elfsight.com"],
.cc-instagram-feed [class*="eapps-widget-toolbar"],
.cc-instagram-feed [class*="eapps-link"],
.cc-instagram-feed a[aria-label*="Free Instagram"],
.cc-instagram-feed a[title*="Free Instagram"],

}
</style>
<script>
(function () {
    function hideElfsightChrome(root) {
        if (!root || !root.querySelectorAll) {
            return;
        }
        root.querySelectorAll('a[href*="elfsight.com"], a[href*="explore/tags/yummy"]').forEach(function (el) {
            el.style.setProperty('display', 'none', 'important');
            el.style.setProperty('visibility', 'hidden', 'important');
            el.setAttribute('aria-hidden', 'true');
        });
        root.querySelectorAll('[class*="Toolbar"], [class*="toolbar"], [class*="eapps-link"]').forEach(function (el) {
            var text = (el.textContent || '').toLowerCase();
            if (text.indexOf('free instagram') !== -1 || text.indexOf('elfsight') !== -1 || el.querySelector('a[href*="elfsight.com"]')) {
                el.style.setProperty('display', 'none', 'important');
            }
        });
        root.querySelectorAll('*').forEach(function (node) {
            if (node.shadowRoot) {
                hideElfsightChrome(node.shadowRoot);
            }
        });
    }

    function run() {
        var wrap = document.querySelector('.cc-instagram-feed');
        if (wrap) {
            hideElfsightChrome(wrap);
        }
    }

    run();
    document.addEventListener('DOMContentLoaded', run);
    window.addEventListener('load', run);
    setInterval(run, 1000);
})();
</script>


<?php
/**
 * Figma-style PDP review summary — stars + (rating) | N Review
 *
 * @var \Magento\Review\Block\Product\ReviewRenderer $block
 * @var \Magento\Framework\Escaper $escaper
 */

$url = $block->getReviewsUrl() . '#reviews';
$urlForm = $block->getReviewsUrl() . '#review-form';

if (!$block->isReviewEnabled()) {
    return;
}

$reviewCount = (int)$block->getReviewsCount();
$ratingPercent = (float)$block->getRatingSummary(); // 0–100
$ratingOutOfFive = $ratingPercent > 0 ? round($ratingPercent / 20, 1) : 0.0;
$hasReviews = $reviewCount > 0;
?>
<div class="product-reviews-summary cc-pdp-reviews<?= $hasReviews ? '' : ' empty' ?>"
     <?php if ($hasReviews): ?>itemprop="aggregateRating" itemscope itemtype="http://schema.org/AggregateRating"<?php endif; ?>>
    <div class="cc-pdp-stars" aria-hidden="true">
        <?php for ($i = 1; $i <= 5; $i++): ?>
            <?php
            $fill = 0;
            if ($hasReviews) {
                if ($ratingOutOfFive >= $i) {
                    $fill = 100;
                } elseif ($ratingOutOfFive > ($i - 1)) {
                    $fill = (int)round(($ratingOutOfFive - ($i - 1)) * 100);
                }
            }
            ?>
            <span class="cc-pdp-star">
                <span class="cc-pdp-star-fill" style="width: <?= /* @noEscape */ $fill ?>%;"></span>
            </span>
        <?php endfor; ?>
    </div>
    <div class="reviews-actions">
        <?php if ($hasReviews): ?>
            <span class="cc-pdp-rating-value">
                (<span itemprop="ratingValue"><?= $escaper->escapeHtml(number_format($ratingOutOfFive, 1)) ?></span>)
                <meta itemprop="bestRating" content="5"/>
            </span>
            <span class="cc-pdp-reviews-sep" aria-hidden="true">|</span>
            <a class="cc-pdp-reviews-count action view" href="<?= $escaper->escapeUrl($url) ?>">
                <span itemprop="reviewCount"><?= $escaper->escapeHtml((string)$reviewCount) ?></span>
                <?= $escaper->escapeHtml($reviewCount === 1 ? __('Review') : __('Reviews')) ?>
            </a>
        <?php else: ?>
            <a class="cc-pdp-reviews-count action add" href="<?= $escaper->escapeUrl($urlForm) ?>">
                <?= $escaper->escapeHtml(__('Be the first to review')) ?>
            </a>
        <?php endif; ?>
    </div>
</div>

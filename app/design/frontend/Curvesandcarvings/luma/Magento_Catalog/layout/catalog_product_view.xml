<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="css/pdp-figma-v4.css" order="2000"/>
    </head>
    <body>
        <attribute name="class" value="cc-pdp-figma"/>

        <referenceContainer name="product.info.social" remove="true"/>
        <referenceBlock name="product.info.description" remove="true"/>

        <!-- Hide legacy delivery + duplicate disclaimer blocks -->
        <referenceBlock name="product.info.delivery" remove="true"/>
        <referenceContainer name="product.delivery.day" remove="true"/>
        <referenceBlock name="product.info.img.disclaimer" remove="true"/>

        <!-- Match live DOM order: info column, gallery column, then tabs -->
        <move element="product.info.main" destination="content" before="product.info.media"/>
        <move element="product.info.details" destination="content" after="product.info.media"/>
        <referenceContainer name="product.info.media">
            <block class="Magento\Framework\View\Element\Template"
                   name="cc.pdp.media.extras"
                   template="Magento_Catalog::product/view/pdp-media-extras.phtml"
                   after="-"/>
        </referenceContainer>

        <!-- Price + tax note; reviews (with SKU) under title (Figma) -->
        <referenceContainer name="product.info.main">
            <block class="Magento\Framework\View\Element\Template"
                   name="cc.pdp.price.header"
                   template="Magento_Catalog::product/view/pdp-price-header.phtml"
                   before="product.info"/>
        </referenceContainer>

        <referenceBlock name="product.info.price"/>
        <move element="product.info.price" destination="cc.pdp.price.header" before="-"/>
        <move element="product.info.review" destination="product.info.main" after="page.main.title"/>
        <referenceBlock name="product.info.sku" remove="true"/>

        <referenceBlock name="product.attributes">
            <arguments>
                <argument translate="true" name="title" xsi:type="string">Description</argument>
                <argument name="sort_order" xsi:type="string">10</argument>
            </arguments>
        </referenceBlock>

        <referenceBlock name="product.info.details">
            <block class="Magento\Catalog\Block\Product\View\Attributes"
                   name="payment.tab"
                   template="Magento_Catalog::product/view/paymentterms.phtml"
                   group="detailed_info">
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Payment Terms</argument>
                    <argument name="sort_order" xsi:type="string">20</argument>
                </arguments>
            </block>
            <block class="Magento\Catalog\Block\Product\View\Attributes"
                   name="warranty.tab"
                   template="Magento_Catalog::product/view/warrantytab.phtml"
                   group="detailed_info">
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Warranty / Terms</argument>
                    <argument name="sort_order" xsi:type="string">40</argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceBlock name="product.info.form.options"
                        template="Magento_Catalog::product/view/form/options-container.phtml"/>

        <referenceBlock name="product.info.addtocart.instantPurchase" remove="true"/>
        <referenceBlock name="product.info.addtocart.instantPurchase.additional" remove="true"/>
        <referenceBlock name="product.info.addtocart">
            <block class="Magento\Wishlist\Block\Catalog\Product\View\AddTo\Wishlist"
                   name="view.addto.wishlist.cart"
                   template="Magento_Wishlist::catalog/product/view/addto/wishlist.phtml"/>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional">
            <block class="Magento\Wishlist\Block\Catalog\Product\View\AddTo\Wishlist"
                   name="view.addto.wishlist.cart.additional"
                   template="Magento_Wishlist::catalog/product/view/addto/wishlist.phtml"/>
        </referenceBlock>
    </body>
</page>

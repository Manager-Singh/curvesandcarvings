<?php
/**
 * Recently Viewed Products — Figma card section (after PDP content).
 *
 * @var \Curvesandcarvings\Theme\Block\Product\RecentlyViewed $block
 * @var \Magento\Framework\Escaper $escaper
 */

use Magento\Framework\App\Action\Action;

if (!$block->hasItems()) {
    return;
}
$items = $block->getItems();
?>
<section class="cc-pdp-recently-viewed" aria-labelledby="cc-pdp-recently-viewed-title">
    <div class="cc-pdp-recently-viewed-header">
        <h2 id="cc-pdp-recently-viewed-title" class="cc-pdp-recently-viewed-title">
            <?= $escaper->escapeHtml(__('Recently Viewed Products')) ?>
        </h2>
        <p class="cc-pdp-recently-viewed-subtitle">
            <?= $escaper->escapeHtml(__("Here are some products you recently viewed. Don't miss out on these!")) ?>
        </p>
    </div>

    <div class="cc-pdp-recently-viewed-grid">
        <?php foreach ($items as $_product): ?>
            <?php
            /** @var \Magento\Catalog\Model\Product $_product */
            $priceMeta = $block->getPriceMeta($_product);
            $image = $block->getImage($_product, 'category_page_grid');
            $stars = max(0, min(5, $block->getRatingSummary($_product)));
            $wishlistPost = $block->getWishlistPostData($_product);
            $postParams = $_product->isSaleable() ? $block->getAddToCartPostParams($_product) : null;
            ?>
            <article class="cc-pdp-rv-card">
                <div class="cc-pdp-rv-card-media">
                    <?php if ($priceMeta['has_special']): ?>
                        <span class="cc-pdp-rv-badge"><?= $escaper->escapeHtml(__('Limited-Time Deal')) ?></span>
                    <?php endif; ?>
                    <a class="cc-pdp-rv-wishlist action towishlist"
                       href="#"
                       data-post='<?= /* @noEscape */ $wishlistPost ?>'
                       data-action="add-to-wishlist"
                       title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                       aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 20s-7-4.35-7-9.2C5 7.5 7.2 5.5 9.5 5.5c1.4 0 2.6.7 3.5 1.8.9-1.1 2.1-1.8 3.5-1.8C18.8 5.5 21 7.5 21 10.8c0 4.85-7 9.2-7 9.2z"
                                  stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a class="cc-pdp-rv-photo"
                       href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>"
                       tabindex="-1">
                        <?= $image->toHtml() ?>
                    </a>
                </div>

                <div class="cc-pdp-rv-card-body">
                    <h3 class="cc-pdp-rv-name">
                        <a href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>">
                            <?= $escaper->escapeHtml($_product->getName()) ?>
                        </a>
                    </h3>

                    <div class="cc-pdp-rv-stars" aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of 5 stars', $stars)) ?>">
                        <?php for ($i = 1; $i <= 5; $i++): ?>
                            <span class="cc-pdp-rv-star<?= $i <= $stars ? ' is-filled' : '' ?>" aria-hidden="true">★</span>
                        <?php endfor; ?>
                    </div>

                    <div class="cc-pdp-rv-price-row">
                        <span class="cc-pdp-rv-price"><?= /* @noEscape */ $block->formatPrice($priceMeta['final']) ?></span>
                        <?php if ($priceMeta['has_special']): ?>
                            <span class="cc-pdp-rv-old-price"><?= /* @noEscape */ $block->formatPrice($priceMeta['regular']) ?></span>
                            <span class="cc-pdp-rv-discount"><?= $escaper->escapeHtml(__('%1% off', $priceMeta['discount'])) ?></span>
                        <?php endif; ?>
                    </div>

                    <div class="cc-pdp-rv-actions">
                        <a class="cc-pdp-rv-btn-view"
                           href="<?= $escaper->escapeUrl($_product->getProductUrl()) ?>">
                            <span><?= $escaper->escapeHtml(__('View Product')) ?></span>
                            <span class="cc-pdp-rv-btn-arrow" aria-hidden="true">→</span>
                        </a>
                        <?php if ($postParams): ?>
                            <form class="cc-pdp-rv-tocart-form"
                                  data-role="tocart-form"
                                  data-product-sku="<?= $escaper->escapeHtmlAttr($_product->getSku()) ?>"
                                  action="<?= $escaper->escapeUrl($postParams['action']) ?>"
                                  method="post"
                                  data-mage-init='{"catalogAddToCart":{}}'>
                                <input type="hidden" name="product" value="<?= (int)$postParams['data']['product'] ?>"/>
                                <input type="hidden"
                                       name="<?= /* @noEscape */ Action::PARAM_NAME_URL_ENCODED ?>"
                                       value="<?= /* @noEscape */ $postParams['data'][Action::PARAM_NAME_URL_ENCODED] ?>"/>
                                <?= $block->getBlockHtml('formkey') ?>
                                <button type="submit"
                                        class="cc-pdp-rv-btn-cart"
                                        title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <path d="M6 6h15l-1.5 9h-12L6 6z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                                        <path d="M6 6L5 3H2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                        <circle cx="9" cy="20" r="1.4" fill="currentColor"/>
                                        <circle cx="17" cy="20" r="1.4" fill="currentColor"/>
                                    </svg>
                                </button>
                            </form>
                        <?php endif; ?>
                    </div>
                </div>
            </article>
        <?php endforeach; ?>
    </div>
</section>
<script type="text/x-magento-init">
{
    ".cc-pdp-recently-viewed [data-action='add-to-wishlist']": {
        "wishlist": {}
    }
}
</script>

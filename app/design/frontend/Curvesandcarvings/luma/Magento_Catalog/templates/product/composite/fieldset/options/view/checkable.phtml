<?php
/**
 * Custom option radios/checkboxes — Figma-style payment cards + standard options.
 * Never call opConfig.reloadPrice() — percent payment options freeze Chrome.
 *
 * @var \Magento\Catalog\Block\Product\View\Options\View\Checkable $block
 */

use Magento\Catalog\Model\Product\Option;
use Magento\Framework\Registry;

$option = $block->getOption();
$registry = $block->getData('registry');
if (!$registry instanceof Registry) {
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    $registry = $objectManager->get(Registry::class);
}
$currentProduct = $registry->registry('current_product');
$productPrice = $currentProduct ? (float)$currentProduct->getFinalPrice() : 0.0;
$advancePrice = $productPrice > 0 ? round($productPrice * 0.5, 2) : 0;
if ($option) :
    $configValue = $block->getPreconfiguredValue($option);
    $optionType = $option->getType();
    $arraySign = $optionType === Option::OPTION_TYPE_CHECKBOX ? '[]' : '';
    $count = 1;
    $optionTitle = (string)$option->getTitle();
    $isPayment = stripos($optionTitle, 'payment') !== false;
    $wrapperClass = $isPayment ? 'cc-payment-options' : '';
    ?>
<div class="options-list nested <?= $block->escapeHtmlAttr($wrapperClass) ?>"
     id="options-<?= /* @noEscape */ $option->getId() ?>-list">
    <?php if ($optionType === Option::OPTION_TYPE_RADIO && !$option->getIsRequire()) : ?>
    <div class="field choice admin__field admin__field-option">
        <input type="radio"
               id="options_<?= /* @noEscape */ $option->getId() ?>"
               class="radio admin__control-radio product-custom-option"
               name="options[<?= /* @noEscape */ $option->getId() ?>]"
               data-selector="options[<?= /* @noEscape */ $option->getId() ?>]"
               value=""
               checked="checked"
        />
        <label class="label admin__field-label" for="options_<?= /* @noEscape */ $option->getId() ?>">
            <span><?= $block->escapeHtml(__('None')) ?></span>
        </label>
    </div>
    <?php endif; ?>

    <?php
    $needsDefault = $option->getIsRequire()
        && empty($configValue)
        && $optionType === Option::OPTION_TYPE_RADIO;
    $defaultApplied = false;
    ?>
    <?php foreach ($option->getValues() as $value) : ?>
        <?php
        $checked = '';
        $count++;
        if ($arraySign) {
            $checked = is_array($configValue) && in_array($value->getOptionTypeId(), $configValue) ? 'checked' : '';
        } else {
            $checked = $configValue == $value->getOptionTypeId() ? 'checked' : '';
        }
        if ($needsDefault && !$defaultApplied && $checked === '') {
            $checked = 'checked';
            $defaultApplied = true;
        }
        $dataSelector = 'options[' . $option->getId() . ']';
        if ($arraySign) {
            $dataSelector .= '[' . $value->getOptionTypeId() . ']';
        }
        $classar = $block->escapeHtml($value->getTitle());
        $stripped = str_replace(' ', '', $classar);
        $fclasst = substr($stripped, 10);
        $valueTitle = (string)$value->getTitle();
        $isAdvance = stripos($valueTitle, '50%') !== false || stripos($valueTitle, 'Advance') !== false;
        $isEmi = stripos($valueTitle, 'EMI') !== false;
        ?>
        <?php if ($isPayment) : ?>
        <div class="field choice cc-payment-card admin__field admin__field-option <?= /* @noEscape */ $option->getIsRequire() ? 'required' : '' ?> <?= $checked ? 'is-selected' : '' ?>">
            <input type="<?= /* @noEscape */ $optionType ?>"
                   class="<?= /* @noEscape */ $optionType === Option::OPTION_TYPE_RADIO ? 'radio admin__control-radio' : 'checkbox admin__control-checkbox' ?> <?= /* @noEscape */ $option->getIsRequire() ? 'required' : '' ?> product-custom-option"
                   name="options[<?= /* @noEscape */ $option->getId() ?>]<?= /* @noEscape */ $arraySign ?>"
                   id="options_<?= /* @noEscape */ $option->getId() . '_' . $count ?>"
                   value="<?= /* @noEscape */ $value->getOptionTypeId() ?>"
                <?= /* @noEscape */ $checked ?>
                   data-selector="<?= /* @noEscape */ $dataSelector ?>"
                   price="0"/>
            <label class="label admin__field-label cc-payment-card-body"
                   for="options_<?= /* @noEscape */ $option->getId() . '_' . $count ?>">
                <span class="cc-payment-card-left">
                    <span class="cc-payment-title">
                        <?php if ($isEmi) : ?>
                            <?= $block->escapeHtml(__('Flexible EMI Option')) ?>
                        <?php else : ?>
                            <?= $block->escapeHtml($valueTitle) ?>
                        <?php endif; ?>
                    </span>
                    <?php if ($isEmi) : ?>
                        <span class="cc-payment-hint-inline"><?= $block->escapeHtml(__('(Please select EMI option while making the payment)')) ?></span>
                    <?php endif; ?>
                    <?php if ($fclasst) : ?>
                        <span class="<?= $block->escapeHtmlAttr($fclasst) ?>_open k-more"><?= $block->escapeHtml(__('Know More')) ?></span>
                    <?php endif; ?>
                </span>
                <span class="cc-payment-card-right">
                    <span class="cc-payment-price">
                        <?php if ($isAdvance) : ?>
                            <span class="cc-advance-price"><?= $advancePrice > 0 ? '₹' . $block->escapeHtml(number_format($advancePrice, 2, '.', ',')) : $block->escapeHtml(__('Calculating...')) ?></span>
                        <?php elseif ($isEmi) : ?>
                            <span class="lowemishowin cc-emi-monthly"><?= $block->escapeHtml(__('Calculating...')) ?></span>
                        <?php else : ?>
                            <?= /* @noEscape */ $block->formatPrice($value) ?>
                        <?php endif; ?>
                    </span>
                </span>
            </label>
        </div>
        <?php else : ?>
        <div class="field choice admin__field admin__field-option <?= /* @noEscape */ $option->getIsRequire() ? 'required' : '' ?>">
            <input type="<?= /* @noEscape */ $optionType ?>"
                   class="<?= /* @noEscape */ $optionType === Option::OPTION_TYPE_RADIO ? 'radio admin__control-radio' : 'checkbox admin__control-checkbox' ?> <?= /* @noEscape */ $option->getIsRequire() ? 'required' : '' ?> product-custom-option"
                   name="options[<?= /* @noEscape */ $option->getId() ?>]<?= /* @noEscape */ $arraySign ?>"
                   id="options_<?= /* @noEscape */ $option->getId() . '_' . $count ?>"
                   value="<?= /* @noEscape */ $value->getOptionTypeId() ?>"
                <?= /* @noEscape */ $checked ?>
                   data-selector="<?= /* @noEscape */ $dataSelector ?>"
                   price="0"/>
            <?php
                $fclasst = substr(str_replace(' ', '', $block->escapeHtml($value->getTitle())), 10);
            ?>
            <label class="label admin__field-label" for="options_<?= /* @noEscape */ $option->getId() . '_' . $count ?>">
                <span class="<?php if ($fclasst == 'tCard') { echo 'lowemishowin'; } ?>">
                    <?= $block->escapeHtml($value->getTitle()) ?>
                </span>
            </label>
            <span class="<?= $block->escapeHtmlAttr($fclasst) ?>_open k-more"><?= $block->escapeHtml(__('Know More')) ?></span>
        </div>
        <?php endif; ?>
    <?php endforeach; ?>
    <?php if ($isPayment) : ?>
    <p class="cc-payment-hint"><?= $block->escapeHtml(__('(Please select EMI option while making the payment)')) ?></p>
    <?php endif; ?>
</div>
<?php endif; ?>

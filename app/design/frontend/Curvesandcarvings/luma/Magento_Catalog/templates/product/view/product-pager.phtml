<?php
/**
 * Previous / Next product in same category (below breadcrumbs).
 *
 * @var \Curvesandcarvings\Theme\Block\Product\Pager $block
 */

$prev = $block->getPreviousProduct();
$next = $block->getNextProduct();
if (!$prev && !$next) {
    return;
}
?>
<nav class="cc-pdp-product-pager" aria-label="<?= $block->escapeHtmlAttr(__('Product pagination')) ?>">
    <div class="cc-pdp-product-pager-inner">
        <div class="cc-pdp-product-pager-prev">
            <?php if ($prev): ?>
                <?php $prevThumb = $block->getThumbnailUrl($prev); ?>
                <a class="cc-pdp-product-pager-card"
                   href="<?= $block->escapeUrl($prev->getProductUrl()) ?>"
                   title="<?= $block->escapeHtmlAttr($prev->getName()) ?>">
                    <span class="cc-pdp-product-pager-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <?php if ($prevThumb): ?>
                        <span class="cc-pdp-product-pager-thumb">
                            <img src="<?= $block->escapeUrl($prevThumb) ?>"
                                 alt=""
                                 width="48"
                                 height="48"
                                 loading="lazy"/>
                        </span>
                    <?php endif; ?>
                    <span class="cc-pdp-product-pager-text">
                        <span class="cc-pdp-product-pager-eyebrow"><?= $block->escapeHtml(__('Previous')) ?></span>
                        <span class="cc-pdp-product-pager-name"><?= $block->escapeHtml($block->getShortName($prev)) ?></span>
                    </span>
                </a>
            <?php endif; ?>
        </div>
        <div class="cc-pdp-product-pager-next">
            <?php if ($next): ?>
                <?php $nextThumb = $block->getThumbnailUrl($next); ?>
                <a class="cc-pdp-product-pager-card"
                   href="<?= $block->escapeUrl($next->getProductUrl()) ?>"
                   title="<?= $block->escapeHtmlAttr($next->getName()) ?>">
                    <?php if ($nextThumb): ?>
                        <span class="cc-pdp-product-pager-thumb">
                            <img src="<?= $block->escapeUrl($nextThumb) ?>"
                                 alt=""
                                 width="48"
                                 height="48"
                                 loading="lazy"/>
                        </span>
                    <?php endif; ?>
                    <span class="cc-pdp-product-pager-text">
                        <span class="cc-pdp-product-pager-eyebrow"><?= $block->escapeHtml(__('Next')) ?></span>
                        <span class="cc-pdp-product-pager-name"><?= $block->escapeHtml($block->getShortName($next)) ?></span>
                    </span>
                    <span class="cc-pdp-product-pager-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </a>
            <?php endif; ?>
        </div>
    </div>
</nav>

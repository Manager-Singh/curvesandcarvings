<style>
/* Keep original link look; ensure opened panel is actually usable */
.hedserch01serch.is-open {
    display: block !important;
    z-index: 100;
}
.hedserch01serch.is-open .block-search .control {
    border-top: 0;
    clear: none;
    margin: 0;
    padding: 0;
}
.hedserch01serch.is-open .block-search input {
    position: static !important;
    left: auto !important;
    margin: 0;
}
.hedserch01serch.is-open .block-search .action.search {
    display: inline-block !important;
}
.hedserch01serch.is-open .block-search .label {
    display: none;
}
</style>
<script>
require(['jquery'], function ($) {
    'use strict';

    // Single delegated handler (avoids double-bind open/close race)
    $(document).off('click.ccSearchToggle').on('click.ccSearchToggle', '.hedserch01icon', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var $panel = $('.hedserch01serch').first();
        var open = !$panel.hasClass('is-open');
        $panel.toggleClass('is-open', open);
        if (open) {
            $panel.show();
            $('.hedserch01icon a').attr('aria-expanded', 'true');
            $panel.find('.block-search .label').addClass('active');
            setTimeout(function () {
                $('#search').trigger('focus');
            }, 50);
        } else {
            $panel.hide();
            $('.hedserch01icon a').attr('aria-expanded', 'false');
            $panel.find('.block-search .label').removeClass('active');
        }
    });

    // Click outside closes
    $(document).off('click.ccSearchOutside').on('click.ccSearchOutside', function (e) {
        if (!$(e.target).closest('.hedserch01').length) {
            $('.hedserch01serch').removeClass('is-open').hide();
            $('.hedserch01icon a').attr('aria-expanded', 'false');
        }
    });
});
</script>

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <!-- Handle /search and /search?q=… → catalog search results (Magento has no Index for frontName search). -->
        <route id="search" frontName="search">
            <module name="Curvesandcarvings_Theme" before="Magento_Search"/>
        </route>
    </router>
</config>

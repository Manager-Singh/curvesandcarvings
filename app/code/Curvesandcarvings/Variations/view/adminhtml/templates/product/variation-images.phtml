    var maxImages = <?= (int)$max ?>;

    function hideMagentoMatrix() {
        var selectors = [
            '[data-index="configurable-matrix"]',
            '[data-index="configurable_products_button_set"]',
            '.admin__field[data-index="configurable-matrix"]',
            '.admin__field[data-index="configurable_products_button_set"]'
        ];
        $(selectors.join(',')).each(function () {
            $(this).hide().addClass('cc-hide-magento-variations-matrix');
        });
        // Hide "Edit Configurations" button text nodes in configurations fieldset
        $('[data-index="configurable"] button, [data-index="configurable"] .action-secondary').each(function () {
            var t = (($(this).text() || '') + '').toLowerCase();
            if (t.indexOf('edit configurations') !== -1 || t.indexOf('create configurations') !== -1 ||
                t.indexOf('add products manually') !== -1) {
                $(this).closest('.admin__field, .admin__control-fields, div').first().hide();
                $(this).hide();
            }
        });
    }
    hideMagentoMatrix();
    setInterval(hideMagentoMatrix, 800);

    var $loader = $('#cc-variation-loader-global');
    if (!$loader.length) {
        $loader = $(
            '<div id="cc-variation-loader-global" style="display:none;">' +
                '<div class="cc-variation-loader__box">' +
                    '<div class="cc-variation-loader__spinner"></div>' +
                    '<div class="cc-variation-loader__text"></div>' +
                '</div>' +
            '</div>'
        );
        $('body').append($loader);
    }
    $loader.find('.cc-variation-loader__text').text($t('Saving variations… Please wait.'));

    $root.on('click', '[data-cc-toggle-images]', function (e) {
        e.preventDefault();
        var $row = $(this).closest('tr.cc-var__row');
        $row.toggleClass('is-open');
        $(this).text($row.hasClass('is-open') ? $t('Hide images') : $t('Images'));
    });

    function showLoader(on, message) {
        if (on) {
            loadingCount++;
            try { $('body').trigger('processStart'); } catch (e) {}
            $loader.stop(true, true).css('display', 'flex');
            if (message) {
                $loader.find('.cc-variation-loader__text').text(message);
            }
            $('body').addClass('cc-variation-saving');
            $saveBtn.prop('disabled', true).addClass('disabled');
            $btnLabel.text($t('Saving…'));
            $status.text($t('Saving…')).removeClass('is-error is-ok');
        } else {
            loadingCount = Math.max(0, loadingCount - 1);
            if (loadingCount === 0) {
                try { $('body').trigger('processStop'); } catch (e) {}
                $loader.hide();
                $('body').removeClass('cc-variation-saving');
                $saveBtn.prop('disabled', false).removeClass('disabled');
                $btnLabel.text(btnDefaultText);
            }
        }
    }

    function clearFieldErrors() {
        $root.find('.cc-field-error').remove();
        $root.find('.cc-has-error').removeClass('cc-has-error');
        $status.text('').removeClass('is-error is-ok');
    }

    function markError($input, message) {
        if (!$input || !$input.length) {
            return;
        }
        $input.addClass('cc-has-error');
        $input.parent().find('.cc-field-error').remove();
        $input.parent().append($('<div class="cc-field-error"/>').text(message));
    }

    function isFilled(val) {
        return $.trim(String(val == null ? '' : val)) !== '';
    }

    function isValidPrice(val) {
        if (!isFilled(val)) {
            return false;
        }
        var n = parseFloat(String(val).replace(/,/g, ''));
        return !isNaN(n) && n >= 0;
    }

    function isValidQty(val) {
        if (!isFilled(val)) {
            return true;
        }
        var n = parseFloat(String(val).replace(/,/g, ''));
        return !isNaN(n) && n >= 0;
    }

    function validateForm() {
        clearFieldErrors();
        var errors = [];
        var $firstError = null;

        $root.find('tr.cc-var__row[data-child-id]').each(function () {
            var $row = $(this);
            var id = $row.data('child-id');
            var $sku = $row.find('[name="variation_sku_' + id + '"]');
            var $name = $row.find('[name="variation_name_' + id + '"]');
            var $price = $row.find('[name="variation_price_' + id + '"]');
            var $option = $row.find('[name="variation_option_' + id + '"]');

            if (!isFilled($sku.val())) {
                markError($sku, $t('SKU is required.'));
                errors.push('sku');
                $firstError = $firstError || $sku;
            }
            if (!isFilled($name.val())) {
                markError($name, $t('Name is required.'));
                errors.push('name');
                $firstError = $firstError || $name;
            }
            if (!isValidPrice($price.val())) {
                markError($price, $t('Enter a valid price.'));
                errors.push('price');
                $firstError = $firstError || $price;
            }
            if (!isFilled($option.val())) {
                markError($option, $t('Select an option.'));
                errors.push('option');
                $firstError = $firstError || $option;
            }
        });

        var newSku = $.trim($root.find('[name="new_sku"]').val() || '');
        var newName = $.trim($root.find('[name="new_name"]').val() || '');
        var newPrice = $.trim($root.find('[name="new_price"]').val() || '');
        var newOptionId = $.trim($root.find('[name="new_option_id"]').val() || '');
        var newOptionLabel = $.trim($root.find('[name="new_option_label"]').val() || '');
        var newQty = $.trim($root.find('[name="new_qty"]').val() || '');
        var hasNewImage = false;
        for (var s = 1; s <= maxImages; s++) {
            var ni = $root.find('[name="new_variation_' + s + '"]')[0];
            if (ni && ni.files && ni.files[0]) {
                hasNewImage = true;
                break;
            }
        }
        var creatingNew = !!(newSku || newName || newPrice || newOptionId || newOptionLabel || hasNewImage);

        if (creatingNew) {
            if (!newSku) {
                markError($root.find('[name="new_sku"]'), $t('SKU is required.'));
                errors.push('new sku');
                $firstError = $firstError || $root.find('[name="new_sku"]');
            }
            if (!newName) {
                markError($root.find('[name="new_name"]'), $t('Name is required.'));
                errors.push('new name');
                $firstError = $firstError || $root.find('[name="new_name"]');
            }
            if (!isValidPrice(newPrice)) {
                markError($root.find('[name="new_price"]'), $t('Enter a valid price.'));
                errors.push('new price');
                $firstError = $firstError || $root.find('[name="new_price"]');
            }
            if (!newOptionId && !newOptionLabel) {
                markError($root.find('[name="new_option_id"]'), $t('Select or create an option.'));
                errors.push('new option');
                $firstError = $firstError || $root.find('[name="new_option_id"]');
            }
            if (newOptionId && newOptionLabel) {
                markError($root.find('[name="new_option_label"]'), $t('Use existing OR new option, not both.'));
                errors.push('both options');
                $firstError = $firstError || $root.find('[name="new_option_label"]');
            }
            if (!isValidQty(newQty)) {
                markError($root.find('[name="new_qty"]'), $t('Invalid qty.'));
                errors.push('qty');
                $firstError = $firstError || $root.find('[name="new_qty"]');
            }
        }

        if (!creatingNew && !$root.find('tr.cc-var__row[data-child-id]').length) {
            errors.push('empty');
        }

        if (errors.length) {
            $status.text($t('Please fix the highlighted fields.')).addClass('is-error');
            if ($firstError && $firstError.length) {
                $('html, body').animate({scrollTop: $firstError.offset().top - 120}, 200);
                $firstError.trigger('focus');
            }
            return false;
        }
        return true;
    }

    $('#cc-scroll-add-variation').on('click', function (e) {
        e.preventDefault();
        var el = document.getElementById('cc-add-variation-panel');
        if (el) {
            el.scrollIntoView({behavior: 'smooth', block: 'start'});
            $('#new_sku').trigger('focus');
        }
    });

    $root.on('input change', '.cc-has-error', function () {
        $(this).removeClass('cc-has-error');
        $(this).parent().find('.cc-field-error').remove();
    });

    function buildFormData() {
        var fd = new FormData();
        fd.append('form_key', formKey);
        fd.append('parent_id', $root.find('input[name="parent_id"]').val());

        $root.find('tr.cc-var__row[data-child-id]').each(function () {
            var $row = $(this);
            var id = $row.data('child-id');
            var $detail = $row.next('.cc-var__detail');
            ['sku', 'name', 'price', 'option'].forEach(function (field) {
                var name = 'variation_' + field + '_' + id;
                var $input = $row.find('[name="' + name + '"]');
                if ($input.length) {
                    fd.append(name, $input.val());
                }
            });
            for (var slot = 1; slot <= maxImages; slot++) {
                var fileHidden = $detail.find('[name="variation_file_' + id + '_' + slot + '"]');
                if (fileHidden.length) {
                    fd.append('variation_file_' + id + '_' + slot, fileHidden.val());
                }
                var remove = $detail.find('[name="variation_remove_' + id + '_' + slot + '"]');
                if (remove.length && remove.is(':checked')) {
                    fd.append('variation_remove_' + id + '_' + slot, '1');
                }
                var fileInput = $detail.find('[name="variation_' + id + '_' + slot + '"]')[0];
                if (fileInput && fileInput.files && fileInput.files[0]) {
                    fd.append('variation_' + id + '_' + slot, fileInput.files[0]);
                }
            }
        });

        ['new_sku', 'new_name', 'new_price', 'new_option_id', 'new_option_label', 'new_qty'].forEach(function (name) {
            var $el = $root.find('[name="' + name + '"]');
            if ($el.length) {
                fd.append(name, $el.val());
            }
        });
        for (var s = 1; s <= maxImages; s++) {
            var ni = $root.find('[name="new_variation_' + s + '"]')[0];
            if (ni && ni.files && ni.files[0]) {
                fd.append('new_variation_' + s, ni.files[0]);
            }
        }
        return fd;
    }

    $saveBtn.on('click', function (e) {
        e.preventDefault();
        if (!validateForm()) {
            return;
        }
        showLoader(true);
        $.ajax({
            url: saveUrl,
            type: 'POST',
            data: buildFormData(),
            processData: false,
            contentType: false,
            headers: {'X-Requested-With': 'XMLHttpRequest'},
            success: function (resp) {
                if (resp && resp.success === false) {
                    showLoader(false);
                    $status.text(resp.message || $t('Could not save variations.')).addClass('is-error');
                    alert(resp.message || $t('Could not save variations.'));
                    return;
                }
                $status.text($t('Saved. Reloading…')).removeClass('is-error').addClass('is-ok');
                window.location.reload();
            },
            error: function (xhr) {
                showLoader(false);
                var msg = (xhr.responseJSON && xhr.responseJSON.message)
                    ? xhr.responseJSON.message
                    : $t('Could not save variations. Please try again.');
                $status.text(msg).addClass('is-error');
                alert(msg);
            }
        });
    });

    $root.on('click', '.cc-variation-delete-btn', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $btn = $(this);
        var sku = $btn.data('sku');
        if (!window.confirm($t('Delete variation "%1"? This removes the simple product.').replace('%1', sku))) {
            return;
        }
        showLoader(true);
        var fd = new FormData();
        fd.append('form_key', formKey);
        $.ajax({
            url: $btn.data('delete-url'),
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            headers: {'X-Requested-With': 'XMLHttpRequest'},
            success: function (resp) {
                if (resp && resp.success === false) {
                    showLoader(false);
                    alert(resp.message || $t('Could not delete variation.'));
                    return;
                }
                window.location.reload();
            },
            error: function (xhr) {
                showLoader(false);
                var msg = (xhr.responseJSON && xhr.responseJSON.message)
                    ? xhr.responseJSON.message
                    : $t('Could not delete variation.');
                alert(msg);
            }
        });
    });
});
</script>

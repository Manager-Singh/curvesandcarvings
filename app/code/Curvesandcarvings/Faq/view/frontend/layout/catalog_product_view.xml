<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Curvesandcarvings_Faq::css/faq.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Curvesandcarvings\Faq\Block\FaqList"
                   name="cc.faq.product"
                   template="Curvesandcarvings_Faq::faq-accordion.phtml"
                   after="cc.pdp.recently.viewed"
                   cacheable="false">
                <arguments>
                    <argument name="location" xsi:type="string">product</argument>
                </arguments>
            </block>
        </referenceContainer>
        <move element="catalog.product.related" destination="content" after="cc.faq.product"/>
        <move element="product.info.upsell" destination="content" after="catalog.product.related"/>
    </body>
</page>

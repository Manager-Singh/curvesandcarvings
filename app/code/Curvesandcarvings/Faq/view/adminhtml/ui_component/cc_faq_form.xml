<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">cc_faq_form.cc_faq_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">FAQ Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Curvesandcarvings\Faq\Block\Adminhtml\Faq\Edit\BackButton"/>
            <button name="delete" class="Curvesandcarvings\Faq\Block\Adminhtml\Faq\Edit\DeleteButton"/>
            <button name="save" class="Curvesandcarvings\Faq\Block\Adminhtml\Faq\Edit\SaveButton"/>
            <button name="save_and_continue" class="Curvesandcarvings\Faq\Block\Adminhtml\Faq\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>cc_faq_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>cc_faq_form.cc_faq_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="cc_faq_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="cc_faq/faq/save"/>
        </settings>
        <dataProvider class="Curvesandcarvings\Faq\Model\DataProvider"
                      name="cc_faq_form_data_source">
            <settings>
                <requestFieldName>faq_id</requestFieldName>
                <primaryFieldName>faq_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="faq_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>faq_id</dataScope>
            </settings>
        </field>
        <field name="question" sortOrder="10" formElement="textarea">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Question</label>
                <dataScope>question</dataScope>
            </settings>
        </field>
        <field name="answer" sortOrder="20" formElement="wysiwyg">
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <label translate="true">Answer</label>
                <dataScope>answer</dataScope>
            </settings>
            <formElements>
                <wysiwyg>
                    <settings>
                        <wysiwyg>true</wysiwyg>
                        <rows>12</rows>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
        <field name="sort_order" sortOrder="30" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Sort Order</label>
                <dataScope>sort_order</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="40" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="show_on">
        <settings>
            <label translate="true">Show On</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="show_on_product" sortOrder="10" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Single product page</label>
                <dataScope>show_on_product</dataScope>
                <notice translate="true">Shown below Recently Viewed on the product detail page.</notice>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="show_on_about" sortOrder="20" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">About Us page</label>
                <dataScope>show_on_about</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="show_on_contact" sortOrder="30" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Contact Us page</label>
                <dataScope>show_on_contact</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="show_on_home" sortOrder="40" formElement="checkbox">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Home page (above footer)</label>
                <dataScope>show_on_home</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>

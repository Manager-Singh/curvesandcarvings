<?php $columnsLimit = $block->getColumnsLimit() ? : 0; ?>
<?php $_menu2 = $block->getHtml('level-top', 'mega', $columnsLimit) ?>
<?php $_menu = $block->getHtml('level-top', 'submenu', $columnsLimit) ?>

<?php if ($block->allowExtension()): ?>
    <?php
    /**
     * Top menu for store
     *
     * @see \Magento\Theme\Block\Html\Topmenu
     */
    ?>
    <nav class="navigation" role="navigation" >

        <div class="menu" id="om">
            <ul>
                <?php /* @escapeNotVerified */ echo $_menu2; ?>
            </ul>
        </div>
        <ul id="dm" data-mage-init='{"menu":{"responsive":true, "expanded":true, "position":{"my":"left top","at":"left bottom"}}}'>
            <?php /* @escapeNotVerified */ echo $_menu; ?>
        </ul>
    </nav>
    <script>
        require(['jquery'], function ($) {
            $(function () {
                var $root = $('#om.menu');
                if (!$root.length) {
                    return;
                }

                var $items = $root.children('ul').children('li');

                $items.filter(function () {
                    return $(this).children('ul').length > 0;
                }).addClass('menu-dropdown-icon');

                $root.find('> ul > li > ul').filter(function () {
                    return $(this).find('ul').length === 0;
                }).addClass('normal-sub');

                if (!$root.children('ul').prev('.menu-mobile').length) {
                    $root.children('ul').before('<a href="#" class="menu-mobile">Navigation</a>');
                }

                $items.each(function () {
                    var $li = $(this);
                    var $sub = $li.children('ul');
                    if (!$sub.length) {
                        return;
                    }

                    $li.on('mouseenter.megamenu', function () {
                        if ($(window).width() > 943) {
                            $sub.stop(true, true).fadeIn(150);
                        }
                    }).on('mouseleave.megamenu', function () {
                        if ($(window).width() > 943) {
                            $sub.stop(true, true).fadeOut(150);
                        }
                    }).on('click.megamenu', function () {
                        if ($(window).width() <= 943) {
                            $sub.stop(true, true).fadeToggle(150);
                        }
                    });
                });

                $root.find('.menu-mobile').on('click.megamenu', function (e) {
                    $root.children('ul').toggleClass('show-on-mobile');
                    e.preventDefault();
                });
            });
        });
    </script>

<?php else : ?>

    <nav class="navigation" role="navigation">
<?php /* @escapeNotVerified */ echo $_menu; ?>
    </nav>
<?php endif; ?>
